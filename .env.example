# Discord 機器人 Token (必填)
DISCORD_TOKEN=your_discord_token_here

# 中央氣象署 (CWA) API 授權碼 (選填，氣象/天氣/降雨/地震相關功能需填寫)
CWA_API_KEY=CWB-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# 環境部 (MOENV) API 授權碼 (選填，空氣品質 AQI 相關功能需填寫)
MOENV_API_KEY=your_moenv_api_key_here

# ADSB 航空器資料 API 網址 (選填)
ADSB_API_URL=http://www.youradsbstation.example/tar1090/data/aircraft.json

# CWA EEW AUTH (選填)
CWA_EEW_AUTH=

# 機器人擁有者 ID 與管理伺服器 ID (選填)
OWNER_ID=123456789012345678
OWNER_SERVER_ID=123456789012345678

# 控制台 Webhook 網址設定 (選填：系統日誌、指令日誌、推播日誌)
CONSOLE_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_URL_HERE
CONSOLE_COMMAND_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_URL_HERE
CONSOLE_PUSH_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_URL_HERE

# RPTeS API Key (震度速報使用)
RF_API_KEY=your_rf_api_key_here

# Groq API Key (至 https://console.groq.com/ 免費申請)
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API Key (至 https://aistudio.google.com/ 免費申請)
GEMINI_API_KEY=your_gemini_api_key_here

# 小裁雨 Gemini 系統提示詞 (System Instruction)
SAIU_SYSTEM_INSTRUCTION=""