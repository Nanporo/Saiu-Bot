# Discord 機器人 Token (必填)
DISCORD_TOKEN=your_discord_token_here

# 中央氣象署 (CWA) API 授權碼 (選填，氣象/天氣/降雨/地震相關功能需填寫)
CWA_API_KEY=CWB-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# 環境部 (MOENV) API 授權碼 (選填，空氣品質 AQI 相關功能需填寫)
MOENV_API_KEY=your_moenv_api_key_here

# ADSB 航空器資料 API 網址 (選填)
ADSB_API_URL=http://www.youradsbstation.example/tar1090/data/aircraft.json

# CWA EEW AUTH (選填)
CWA_EEW_AUTH=

# 機器人擁有者 ID 與管理伺服器 ID (選填)
OWNER_ID=123456789012345678
OWNER_SERVER_ID=123456789012345678

# 控制台頻道 ID 設定 (選填)
CONSOLE_ID=123456789012345678
CONSOLE_COMMAND_ID=123456789012345678
CONSOLE_PUSH_ID=123456789012345678
